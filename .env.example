# Screenplay Studio Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# APP CONFIGURATION (Client-visible)
# ============================================================================
VITE_APP_NAME="Screenplay Studio"
VITE_APP_URL="http://localhost:5173"

# ============================================================================
# SUPABASE (Client-visible for auth/db; Service role is server-only)
# ============================================================================
# Get from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# SERVER-ONLY - Never expose to client!
# Get from: Supabase Dashboard > Project Settings > API > Service Role Key
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================================================
# GROQ AI (Server-only)
# ============================================================================
# Get from: https://console.groq.com/keys
# GROQ_API_KEY="your-groq-api-key"
# GROQ_MODEL="openai/gpt-oss-20b"

# ============================================================================
# GOOGLE OAUTH (Client-visible for auth)
# ============================================================================
# Get from: Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# SERVER-ONLY - Google OAuth secret
# GOOGLE_CLIENT_SECRET="your-google-oauth-secret"

# ============================================================================
# GOOGLE DRIVE (Server-only, separate from Google Sign-In)
# ============================================================================
# Get from: Google Cloud Console > APIs & Services > Credentials (separate OAuth client)
# GOOGLE_DRIVE_CLIENT_ID="your-drive-client-id"
# GOOGLE_DRIVE_CLIENT_SECRET="your-drive-secret"

# ============================================================================
# SERVER SESSION/ENCRYPTION (Server-only)
# ============================================================================
# Generate with: openssl rand -base64 32
# SESSION_SECRET="your-session-secret"
# ENCRYPTION_KEY="your-32-byte-base64-encryption-key"